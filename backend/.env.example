NODE_ENV=development
PORT=3333
DATABASE_URL=postgres://postgres:postgres@localhost:5432/courses
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/courses_test
# Set to true on Heroku Postgres
DATABASE_SSL=false
CORS_ORIGIN=*

# Auth. Required in production (min. 32 chars): openssl rand -base64 48
JWT_SECRET=
# Session length in seconds (default 8h)
JWT_TTL_SECONDS=28800
# Set to false to disable self sign-up (admins still create users in the admin panel)
ALLOW_SIGNUP=true
# Defaults to true in production. Set false only when serving over plain HTTP (local Docker)
# COOKIE_SECURE=false

# Password used by the seed for every sample account (demo only)
SEED_PASSWORD=SyncTech@2026
